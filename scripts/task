#!/bin/sh
# The single seam between this project and every piece of automation around it.
# CI, the git hooks, and scripts/agent know only these verbs, so they cannot
# drift from what a developer runs locally. Stack-specific commands live here
# and nowhere else.
set -eu

usage() {
	cat <<'USAGE'
Usage: scripts/task <target>

Targets:
  fmt        Format the tree in place
  fmt:check  Verify formatting; non-zero on drift
  lint       Lint; warnings are errors
  test       Run the full test suite
  build      Build the release binary
  check      fmt:check && lint && test && build
USAGE
}

case "${1:-}" in
fmt)
	cargo fmt --all
	;;
fmt:check)
	cargo fmt --all -- --check
	;;
lint)
	cargo clippy --all-targets --all-features --locked -- -D warnings
	;;
test)
	cargo test --all-targets --all-features --locked
	;;
build)
	cargo build --release --locked
	;;
check)
	"$0" fmt:check
	"$0" lint
	"$0" test
	"$0" build
	;;
-h | --help | help | "")
	usage
	;;
*)
	printf 'scripts/task: unknown target `%s`\n\n' "$1" >&2
	usage >&2
	exit 2
	;;
esac
