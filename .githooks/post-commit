#!/bin/sh
# Put what you just committed on your PATH.
#
# `post-merge` keeps the binary matching the default branch, which is the wrong
# thing to be testing: work happens on a branch, and until it merges the PATH
# holds the previous version. Committing in a worktree should mean running that
# worktree.
set -eu

# CI commits nothing worth installing, and installs nothing.
[ -n "${CI:-}" ] && exit 0
command -v cargo >/dev/null 2>&1 || exit 0

root=$(git rev-parse --show-toplevel)

# A commit that cannot change the binary should not cost a build.
if git -C "$root" diff --quiet HEAD~1 HEAD -- src Cargo.toml Cargo.lock build.rs 2>/dev/null; then
	exit 0
fi

printf '\033[1m==>\033[0m post-commit: installing %s\n' "$(git -C "$root" rev-parse --short HEAD)"
# Never fail the commit over this: the commit is already made, and a failed
# install is a stale binary rather than lost work.
"$root/scripts/task" install || printf '    install failed; run scripts/task install when convenient\n'
