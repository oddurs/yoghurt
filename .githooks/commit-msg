#!/bin/sh
# Reject anything that is not a valid Conventional Commit, and reject any
# assistant/AI attribution before it can reach a git object.
set -eu

msg_file=$1
fail() {
	printf '\033[31mcommit-msg:\033[0m %s\n' "$*" >&2
	exit 1
}

# Ignore comments and the diff git appends under --verbose.
body=$(sed -e '/^#/d' -e '/^diff --git /,$d' "$msg_file")
subject=$(printf '%s\n' "$body" | sed -e '/^[[:space:]]*$/d' -e 'q')

[ -n "$subject" ] || fail "empty commit message"

# Merges, reverts and fixups are generated by git; let them through.
case "$subject" in
Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|chore|docs|perf|refactor|test|build|ci|style)(\([a-z0-9._/-]+\))?!?: [^ ].*$'
printf '%s' "$subject" | grep -Eq "$pattern" || fail "subject must be a Conventional Commit:

    <type>(<optional scope>)<optional !>: <subject>

  type is one of: feat fix chore docs perf refactor test build ci style

  got: $subject"

length=$(printf '%s' "$subject" | wc -c | tr -d ' ')
[ "$length" -le 72 ] || fail "subject is $length characters; the limit is 72"

case "$subject" in
*.) fail "subject must not end with a period" ;;
esac

attribution='claude|anthropic|generated with|written by an ai'
trailer='^co-authored-by:.*(claude|copilot|chatgpt|openai|anthropic|\\[bot\\])'
offenders=$(printf '%s\n' "$body" | grep -Eni "$attribution" || true)
offenders="$offenders$(printf '%s\n' "$body" | grep -Eni "$trailer" || true)"
offenders="$offenders$(printf '%s\n' "$body" | grep -n '\xf0\x9f\xa4\x96' || true)"
if [ -n "$(printf '%s' "$offenders" | tr -d '[:space:]')" ]; then
	fail "commit message contains assistant attribution; this repository is published under its author's name.

  offending line(s):
$(printf '%s\n' "$offenders" | sed '/^$/d;s/^/    /')"
fi
